[data-scheme=dark] .airport-mirror:hover{background:rgba(165,180,252,.12);border-color:rgba(165,180,252,.7)}
[data-scheme=dark] .airport-protocol{background:rgba(167,139,250,.14);border-color:rgba(167,139,250,.38)}
[data-scheme=dark] .airport-protocol strong{color:#c4b5fd}
