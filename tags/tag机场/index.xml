.airport-row{padding:1rem 1.4rem;display:flex;flex-wrap:wrap;align-items:center;gap:.7rem}
.airport-row+.airport-row{border-top:1px dashed var(--card-separator-color,rgba(0,0,0,.08))}
.airport-info{padding:.85rem 1.4rem;background:linear-gradient(90deg,rgba(255,184,77,.18),rgba(255,184,77,.04));border-bottom:1px dashed rgba(240,160,64,.4);font-size:1.4rem;color:var(--card-text-color-main,#333);display:flex;align-items:center;gap:.55rem;line-height:1.5}
.airport-info::before{content:"📣";flex:0 0 auto}
.airport-coupon{position:relative;display:inline-flex;align-items:stretch;border:1.5px dashed #f0a040;background:linear-gradient(135deg,#fff7e6 0%,#ffe4cc 100%);border-radius:10px;overflow:hidden;cursor:pointer;font-family:inherit;font-size:1.4rem;padding:0;line-height:1.4;color:inherit;transition:transform .15s ease,box-shadow .15s ease}
.airport-coupon:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(240,160,64,.32)}
.airport-coupon-desc{padding:.5rem .85rem;color:#7a4500;font-weight:500;display:inline-flex;align-items:center;gap:.35rem}
.airport-coupon-code{padding:.5rem 1rem;background:linear-gradient(135deg,#ff7a00 0%,#ff4d4d 100%);color:#fff;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-weight:700;letter-spacing:.06em;display:inline-flex;align-items:center;gap:.35rem}
.airport-coupon-code::before{content:"📋";font-size:.9em;opacity:.9}
.airport-coupon.expired{opacity:.5;cursor:not-allowed;text-decoration:line-through}
.airport-coupon.expired:hover{transform:none;box-shadow:none}
.airport-coupon-feedback{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,#10b981,#059669);color:#fff;font-weight:600;font-size:1.35rem;opacity:0;transform:scale(.9);transition:opacity .2s ease,transform .2s ease;pointer-events:none;letter-spacing:.03em}
.airport-coupon.copied .airport-coupon-feedback{opacity:1;transform:scale(1)}
.airport-coupon.copied .airport-coupon-feedback::before{content:"✓ 已复制"}
.airport-cta{flex:1 1 auto;display:inline-flex;align-items:center;justify-content:center;gap:.5rem;padding:.85rem 1.6rem;background:linear-gradient(135deg,#2563eb 0%,#7c3aed 100%);color:#fff!important;text-decoration:none!important;font-weight:600;font-size:1.55rem;border-radius:10px;box-shadow:0 4px 14px rgba(37,99,235,.32);transition:transform .18s ease,box-shadow .18s ease;min-width:220px;border:none}
.airport-cta:hover{transform:translateY(-1px);box-shadow:0 6px 18px rgba(37,99,235,.42)}
.airport-mirror{display:inline-flex;align-items:center;justify-content:center;gap:.4rem;padding:.7rem 1.1rem;background:transparent;color:#2563eb!important;text-decoration:none!important;border:1.5px solid rgba(37,99,235,.45);border-radius:10px;font-weight:500;font-size:1.35rem;transition:background .15s ease,border-color .15s ease}
.airport-mirror:hover{background:rgba(37,99,235,.08);border-color:rgba(37,99,235,.7)}
